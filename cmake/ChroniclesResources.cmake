function(chronicles_process_resources target role description)
  if(WIN32)
    set(CHRONICLES_PROCESS_ICON "${PROJECT_SOURCE_DIR}/resources/chronicles-${role}.ico")
    set(CHRONICLES_PROCESS_DESCRIPTION "${description}")
    set(resource "${CMAKE_CURRENT_BINARY_DIR}/${target}-version.rc")
    configure_file("${PROJECT_SOURCE_DIR}/resources/process.rc.in" "${resource}" @ONLY)
    target_sources(${target} PRIVATE "${resource}")
  endif()
endfunction()
